# Server-only endpoint of the Jikan provider, for example https://api.jikan.moe/v4.
JIKAN_API_URL=
TMDB_READ_TOKEN=

# MySQL. Set DB_SSL=true in production. Certificates are always verified.
DB_HOST=
DB_PORT=3306
DB_NAME=
DB_USER=
DB_PASSWORD=
DB_CONNECTION_LIMIT=3
DB_QUEUE_LIMIT=12
DB_CONNECT_TIMEOUT_MS=5000
DB_QUERY_TIMEOUT_MS=10000
DB_SSL=true
DB_SSL_REJECT_UNAUTHORIZED=true
# Custom CA from your provider. Set exactly one of these two, not both.
# DB_SSL_CA takes a multiline PEM. DB_SSL_CA_PATH points at a file the server can read.
DB_SSL_CA=
DB_SSL_CA_PATH=

# Next.js sessions. At least 32 random bytes. Do not reuse it anywhere else.
SESSION_SECRET=

# Public address of the app, used in the links inside emails. HTTPS in production.
# Leave it empty locally and it falls back to http://localhost:3000.
NEXT_PUBLIC_APP_URL=

# How many trusted reverse proxies add X-Forwarded-For. Keep 0 locally.
TRUSTED_PROXY_HOPS=0

# Diagnostic flag for development and test only. DISABLE_AUTH_GATE=true is banned in production.
DISABLE_AUTH_GATE=false

# SMTP, server-only.
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
# Sender name shown in the inbox. Empty falls back to the app name.
SMTP_FROM_NAME=

# Signatures for HLS and preview. Its own secret, at least 32 random bytes. There is no fallback.
VIDEO_SIGNING_SECRET=

MEDIA_FILE_ORIGIN=

# Shared configuration of the B2 bucket behind the S3 API.
B2_ENDPOINT=
B2_REGION=
B2_BUCKET=

# Playback: read-only key scoped to media/.
B2_READ_KEY_ID=
B2_READ_APP_KEY=

# Watch party: read and write key scoped to party-chat/, for images posted in room chat.
# Without it, sending an image returns 503 naming the missing variable.
B2_PARTY_WRITE_KEY_ID=
B2_PARTY_WRITE_APP_KEY=

# Artwork: read and write key scoped to artwork/.
B2_ARTWORK_WRITE_KEY_ID=
B2_ARTWORK_WRITE_APP_KEY=

# Deleting media: a separate key scoped to media/. The code only lists and deletes with it,
# so do not grant it bucket management or access to artwork/.
B2_DELETE_KEY_ID=
B2_DELETE_APP_KEY=

# Asset registration from the worker to Next.js. The same secret in both processes,
# at least 32 random bytes. Do not reuse SESSION_SECRET, VIDEO_SIGNING_SECRET or JWT_SECRET.
MEDIA_REGISTRY_SECRET=

# Demo material shown to viewers who have no access to a title.
# Both values only work together. Missing them gives the no-access screen,
# never a real file. The asset you point at must have status ready and the
# system level in series_access, so that it stays out of the catalog.
DEMO_ASSET_SERIES_KEY=
DEMO_ASSET_EPISODE_KEY=

# Watch party: channel service key in the form <key name>:<secret>.
# Server-side only. The client gets a short lived token scoped to one room,
# with listen rights and nothing more. Without this variable rooms are off
# and the rest of the app keeps working.
PARTY_REALTIME_KEY=

# Origin of the event stream. next.config.ts reads the same value to add the host
# to connect-src in the CSP, and without it the browser blocks the connection.
# For Ably: https://realtime.ably.io
PARTY_REALTIME_STREAM_ORIGIN=

# Origin of the API that issues tokens and publishes events. Optional.
# For Ably it defaults to https://rest.ably.io
PARTY_REALTIME_REST_ORIGIN=
